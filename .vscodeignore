# Source files - only include compiled output
src/**
!src/resources/**
**/*.ts
!out/**/*.d.ts

# Build artifacts
**/*.map
.vscode-test/**
.vscode-test.mjs
out/test/**

# Development files
.vscode/**
.vscode-test*
.sfdx/**
.gitignore
.git/**
.gitattributes
**/tsconfig.json
**/tsconfig.base.json
contributing.md
.travis.yml
.eslintrc*
eslint.config.*
AGENTS.md
CLAUDE.md
COMMAND_CENTER_ISSUES.md
DATAWEAVE_*.md
DEPLOYMENT.md
TESTING_*.md
tmp-metrics.html
vsc-extension-quickstart.md
vss-extension.json
scripts/**

# IDE and environment files
.claude/**
.cursor/**
.sfdx/**
.sf/**
.expo/**
.venv/**
.env*
*.code-workspace

# Test files
**/test/**
**/*.test.js
**/*.spec.js

# Local/dev config (region OAuth creds are compiled into out/constants.js at build time)
config/**

# Documentation (keep only what's needed)
.github/**
docs/**
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
COMMAND_CENTER_ISSUES.md
DATAWEAVE_PLAYGROUND.md
DATAWEAVE_QUICKSTART.md
DEPLOYMENT.md
TESTING_CHECKLIST.md
TESTING_IMPLEMENTATION.md
TESTING_SUMMARY.md

# Stray dev artifacts
tmp-metrics.html
vss-extension.json
vsc-extension-quickstart.md
mulelogo.png
.expo/**

# Exclude package manager files
**/package-lock.json
**/yarn.lock
**/.yarn/**

# Trim bundled runtime dependency docs/tests
node_modules/**/*.md
node_modules/**/test/**
node_modules/**/tests/**

# Miscellaneous
*.vsix
**/.DS_Store
**/.editorconfig
**/.eslintcache
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
